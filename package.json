{
  "name": "rivan-cybersecurity-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Rivan Cybersecurity Lab: network traffic analysis exercises, verified walkthroughs, documentation, and downloadable evidence.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/build-downloads.ts --verify",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir src",
    "downloads:build": "tsx scripts/build-downloads.ts",
    "downloads:verify": "tsx scripts/build-downloads.ts --verify",
    "check:filters": "tsx scripts/check-filters.ts",
    "check:site": "node scripts/check-site.mjs"
  },
  "engines": {
    "node": ">=22.2"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
